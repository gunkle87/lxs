INPUT(a0)
INPUT(b0)
INPUT(a1)
INPUT(b1)
INPUT(cin_n)

and0 = AND(a0, b0)
nor0 = NOR(a0, b0)
xor0 = NOR(nor0, and0)
sum0 = XNOR(cin_n, xor0)
inner0 = NOR(cin_n, nor0)
carry0_n = NOR(and0, inner0)

and1 = AND(a1, b1)
nor1 = NOR(a1, b1)
xor1 = NOR(nor1, and1)
sum1 = XNOR(carry0_n, xor1)
inner1 = NOR(carry0_n, nor1)
cout_n = NOR(and1, inner1)

OUTPUT(sum0)
OUTPUT(sum1)
OUTPUT(cout_n)
