INPUT(en)
OUTPUT(q0)
OUTPUT(q1)
OUTPUT(q2)
OUTPUT(q3)
OUTPUT(y0)
OUTPUT(y1)
n_en = NOT(en)
s0 = NOT(q0)
c1 = BUF(q0)
s1 = XOR(q1,c1)
c2 = AND(q1,c1)
s2 = XOR(q2,c2)
c3 = AND(q2,c2)
s3 = XOR(q3,c3)
h0 = AND(q0,n_en)
l0 = AND(s0,en)
n0 = OR(h0,l0)
q0 = DFF(n0)
h1 = AND(q1,n_en)
l1 = AND(s1,en)
n1 = OR(h1,l1)
q1 = DFF(n1)
h2 = AND(q2,n_en)
l2 = AND(s2,en)
n2 = OR(h2,l2)
q2 = DFF(n2)
h3 = AND(q3,n_en)
l3 = AND(s3,en)
n3 = OR(h3,l3)
q3 = DFF(n3)
y0 = XOR(q0,q1,q2,q3)
y1 = NOR(q0,q1,q2,q3)
