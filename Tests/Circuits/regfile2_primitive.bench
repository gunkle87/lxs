INPUT(ra)
INPUT(wa)
INPUT(d0)
INPUT(d1)
INPUT(d2)
INPUT(d3)
INPUT(we)
OUTPUT(m0)
OUTPUT(m1)
OUTPUT(m2)
OUTPUT(m3)
OUTPUT(y0)
OUTPUT(y1)
nra = NOT(ra)
nwa = NOT(wa)
sr0 = BUF(nra)
sr1 = BUF(ra)
sw0 = AND(nwa,we)
sw1 = AND(wa,we)
nsw0 = NOT(sw0)
nsw1 = NOT(sw1)
m0r0 = AND(q00,sr0)
m0r1 = AND(q10,sr1)
m0 = OR(m0r0,m0r1)
m1r0 = AND(q01,sr0)
m1r1 = AND(q11,sr1)
m1 = OR(m1r0,m1r1)
m2r0 = AND(q02,sr0)
m2r1 = AND(q12,sr1)
m2 = OR(m2r0,m2r1)
m3r0 = AND(q03,sr0)
m3r1 = AND(q13,sr1)
m3 = OR(m3r0,m3r1)
y0 = XOR(m0,m1,m2,m3)
y1 = NOR(m0,m1,m2,m3)
h00 = AND(q00,nsw0)
l00 = AND(d0,sw0)
n00 = OR(h00,l00)
q00 = DFF(n00)
h01 = AND(q01,nsw0)
l01 = AND(d1,sw0)
n01 = OR(h01,l01)
q01 = DFF(n01)
h02 = AND(q02,nsw0)
l02 = AND(d2,sw0)
n02 = OR(h02,l02)
q02 = DFF(n02)
h03 = AND(q03,nsw0)
l03 = AND(d3,sw0)
n03 = OR(h03,l03)
q03 = DFF(n03)
h10 = AND(q10,nsw1)
l10 = AND(d0,sw1)
n10 = OR(h10,l10)
q10 = DFF(n10)
h11 = AND(q11,nsw1)
l11 = AND(d1,sw1)
n11 = OR(h11,l11)
q11 = DFF(n11)
h12 = AND(q12,nsw1)
l12 = AND(d2,sw1)
n12 = OR(h12,l12)
q12 = DFF(n12)
h13 = AND(q13,nsw1)
l13 = AND(d3,sw1)
n13 = OR(h13,l13)
q13 = DFF(n13)
