OUTPUT(cout)
OUTPUT(eq)
OUTPUT(lt)
OUTPUT(gt)

one = NOT(_zero)
nop0 = NOT(op0)
nop1 = NOT(op1)
nop2 = NOT(op2)

nb0 = NOT(b0)
nb1 = NOT(b1)
nb2 = NOT(b2)
nb3 = NOT(b3)
nb4 = NOT(b4)
nb5 = NOT(b5)
nb6 = NOT(b6)
nb7 = NOT(b7)

add0,add1,add2,add3,add4,add5,add6,add7,add_cout = ADD8(a0,a1,a2,a3,a4,a5,a6,a7,b0,b1,b2,b3,b4,b5,b6,b7,_zero)
sub0,sub1,sub2,sub3,sub4,sub5,sub6,sub7,sub_cout = ADD8(a0,a1,a2,a3,a4,a5,a6,a7,nb0,nb1,nb2,nb3,nb4,nb5,nb6,nb7,one)
eq,lt,gt = CMP8(a0,a1,a2,a3,a4,a5,a6,a7,b0,b1,b2,b3,b4,b5,b6,b7)

and0 = AND(a0, b0)
and1 = AND(a1, b1)
and2 = AND(a2, b2)
and3 = AND(a3, b3)
and4 = AND(a4, b4)
and5 = AND(a5, b5)
and6 = AND(a6, b6)
and7 = AND(a7, b7)

or0 = OR(a0, b0)
or1 = OR(a1, b1)
or2 = OR(a2, b2)
or3 = OR(a3, b3)
or4 = OR(a4, b4)
or5 = OR(a5, b5)
or6 = OR(a6, b6)
or7 = OR(a7, b7)

xor0 = XOR(a0, b0)
xor1 = XOR(a1, b1)
xor2 = XOR(a2, b2)
xor3 = XOR(a3, b3)
xor4 = XOR(a4, b4)
xor5 = XOR(a5, b5)
xor6 = XOR(a6, b6)
xor7 = XOR(a7, b7)

g00,g01,g02,g03,g04,g05,g06,g07 = MUX4_8(add0,add1,add2,add3,add4,add5,add6,add7,sub0,sub1,sub2,sub3,sub4,sub5,sub6,sub7,and0,and1,and2,and3,and4,and5,and6,and7,or0,or1,or2,or3,or4,or5,or6,or7,op0,op1)
g10,g11,g12,g13,g14,g15,g16,g17 = MUX4_8(xor0,xor1,xor2,xor3,xor4,xor5,xor6,xor7,a0,a1,a2,a3,a4,a5,a6,a7,b0,b1,b2,b3,b4,b5,b6,b7,_zero,_zero,_zero,_zero,_zero,_zero,_zero,_zero,op0,op1)
y0,y1,y2,y3,y4,y5,y6,y7 = MUX2_8(g00,g01,g02,g03,g04,g05,g06,g07,g10,g11,g12,g13,g14,g15,g16,g17,op2)

cout_l0a = AND(add_cout, nop0)
cout_l0b = AND(sub_cout, op0)
cout_l0 = OR(cout_l0a, cout_l0b)
cout_g0a = AND(cout_l0, nop1)
cout_g0b = AND(_zero, op1)
cout_g0 = OR(cout_g0a, cout_g0b)
cout_fa = AND(cout_g0, nop2)
cout_fb = AND(_zero, op2)
cout = OR(cout_fa, cout_fb)
