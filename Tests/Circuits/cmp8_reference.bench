INPUT(b7)

OUTPUT(eq)
OUTPUT(lt)
OUTPUT(gt)

n0 = XOR(a0, b0)
n1 = XOR(a1, b1)
n2 = XOR(a2, b2)
n3 = XOR(a3, b3)
n4 = XOR(a4, b4)
