p5 = AND(p6, e5)
p4 = AND(p5, e4)
p3 = AND(p4, e3)
p2 = AND(p3, e2)
p1 = AND(p2, e1)
eq = AND(p1, e0)
na7 = NOT(a7)
na6 = NOT(a6)
na5 = NOT(a5)
