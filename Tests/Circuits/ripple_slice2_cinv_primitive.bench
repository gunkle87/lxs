INPUT(a0)
INPUT(b0)
INPUT(a1)
INPUT(b1)
INPUT(cin_n)

OUTPUT(sum0)
OUTPUT(sum1)
OUTPUT(cout_n)

and0 = AND(a0, b0)
nor0 = NOR(a0, b0)
xnor0 = NOR(and0, nor0)
sum0 = XNOR(xnor0, cin_n)
inner0 = NOR(cin_n, nor0)
carry0 = NOR(and0, inner0)

and1 = AND(a1, b1)
nor1 = NOR(a1, b1)
xnor1 = NOR(and1, nor1)
sum1 = XNOR(xnor1, carry0)
inner1 = NOR(carry0, nor1)
cout_n = NOR(and1, inner1)
