INPUT(a0)
INPUT(b0)
INPUT(a1)
INPUT(b1)
INPUT(a2)
INPUT(b2)
INPUT(a3)
INPUT(b3)

OUTPUT(out)
OUTPUT(tap0)
OUTPUT(tap1)
OUTPUT(tap2)
OUTPUT(tap3)

x0 = XOR(a0, b0)
x1 = XOR(a1, b1)
x2 = XOR(a2, b2)
x3 = XOR(a3, b3)
n0 = NOT(x0)
n1 = NOT(x1)
n2 = NOT(x2)
n3 = NOT(x3)
tap0 = BUF(n0)
tap1 = BUF(n1)
tap2 = BUF(n2)
tap3 = BUF(n3)
t0 = AND(n0, n1, n2, x3)
t1 = AND(n0, n1, x2, n3)
t2 = AND(n0, x1, n2, n3)
t3 = AND(x0, n1, n2, n3)
out = OR(t0, t1, t2, t3)
