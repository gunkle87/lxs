INPUT(ra0)
INPUT(ra1)
INPUT(wa0)
INPUT(wa1)
INPUT(d0)
INPUT(d1)
INPUT(d2)
INPUT(d3)
INPUT(we)
OUTPUT(m0)
OUTPUT(m1)
OUTPUT(m2)
OUTPUT(m3)
OUTPUT(w0)
OUTPUT(w1)
OUTPUT(w2)
OUTPUT(w3)
OUTPUT(y0)
OUTPUT(y1)
m0,m1,m2,m3 = RAM(ra0,ra1 ; wa0,wa1 ; w0,w1,w2,w3 ; we ; 0x1,0x6,0x0,0xF)
w0 = XOR(m0,d0)
w1 = XOR(m1,d1)
w2 = XOR(m2,d2)
w3 = XOR(m3,d3)
y0 = XOR(m0,m1,m2,m3)
y1 = NOR(m0,m1,m2,m3)
