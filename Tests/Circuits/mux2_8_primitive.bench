INPUT(a0)
INPUT(a1)
INPUT(a2)
INPUT(a3)
INPUT(a4)
INPUT(a5)
INPUT(a6)
INPUT(a7)
INPUT(b0)
INPUT(b1)
INPUT(b2)
INPUT(b3)
INPUT(b4)
INPUT(b5)
INPUT(b6)
INPUT(b7)
INPUT(s)

OUTPUT(q0)
OUTPUT(q1)
OUTPUT(q2)
OUTPUT(q3)
OUTPUT(q4)
OUTPUT(q5)
OUTPUT(q6)
OUTPUT(q7)

ns = NOT(s)

q0_lo = AND(a0, ns)
q0_hi = AND(b0, s)
q0 = OR(q0_lo, q0_hi)
q1_lo = AND(a1, ns)
q1_hi = AND(b1, s)
q1 = OR(q1_lo, q1_hi)
q2_lo = AND(a2, ns)
q2_hi = AND(b2, s)
q2 = OR(q2_lo, q2_hi)
q3_lo = AND(a3, ns)
q3_hi = AND(b3, s)
q3 = OR(q3_lo, q3_hi)
q4_lo = AND(a4, ns)
q4_hi = AND(b4, s)
q4 = OR(q4_lo, q4_hi)
q5_lo = AND(a5, ns)
q5_hi = AND(b5, s)
q5 = OR(q5_lo, q5_hi)
q6_lo = AND(a6, ns)
q6_hi = AND(b6, s)
q6 = OR(q6_lo, q6_hi)
q7_lo = AND(a7, ns)
q7_hi = AND(b7, s)
q7 = OR(q7_lo, q7_hi)
